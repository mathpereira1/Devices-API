# Copy this file to .env and adjust the values.
# docker compose reads .env automatically; every variable has a default.

# Set to Development to enable the API docs at /scalar/v1
ASPNETCORE_ENVIRONMENT=Production

# Host port the API is published on
API_PORT=8080

# PostgreSQL credentials (the API connection string is built from them)
POSTGRES_USER=devices
POSTGRES_PASSWORD=devices
POSTGRES_DB=devices
